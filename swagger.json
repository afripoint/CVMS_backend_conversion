{"swagger": "2.0", "info": {"title": "Custom Verification Management System", "description": "", "version": "v1"}, "host": "127.0.0.1:8000", "schemes": ["http"], "basePath": "/", "consumes": ["application/json"], "produces": ["application/json"], "securityDefinitions": {"Basic": {"type": "basic"}}, "security": [{"Basic": []}], "paths": {"/api/token/": {"post": {"operationId": "api_token_create", "description": "Takes a set of user credentials and returns an access and refresh JSON web\ntoken pair to prove the authentication of those credentials.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/TokenObtainPair"}}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/TokenObtainPair"}}}, "tags": ["api"]}, "parameters": []}, "/api/token/refresh/": {"post": {"operationId": "api_token_refresh_create", "description": "Takes a refresh type JSON web token and returns an access type JSON web\ntoken if the refresh token is valid.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/TokenRefresh"}}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/TokenRefresh"}}}, "tags": ["api"]}, "parameters": []}, "/api/token/verify/": {"post": {"operationId": "api_token_verify_create", "description": "Takes a token and indicates if it is valid.  This view provides no\ninformation about a token's fitness for a particular use.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/TokenVerify"}}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/TokenVerify"}}}, "tags": ["api"]}, "parameters": []}, "/auth/create/sub-account/": {"post": {"operationId": "auth_create_sub-account_create", "description": "API view for creating a sub-user under a company or agent account.\nOnly users with the 'company account' or 'agent account/freight forwarders' role can create sub-users.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/SubAccount"}}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/SubAccount"}}, "400": {"description": "Validation errors"}, "403": {"description": "Unauthorized access"}}, "tags": ["auth"]}, "parameters": []}, "/auth/deactivate-activate/sub-account/{slug}/": {"patch": {"operationId": "auth_deactivate-activate_sub-account_partial_update", "description": "Deactivate and activate a sub-account by slug", "parameters": [], "responses": {"200": {"description": "Sub-account deactivated/activated successfully."}, "404": {"description": "Sub-account not found."}}, "tags": ["auth"]}, "parameters": [{"name": "slug", "in": "path", "required": true, "type": "string"}]}, "/auth/detail/sub-account/{slug}/": {"get": {"operationId": "auth_detail_sub-account_read", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["auth"]}, "parameters": [{"name": "slug", "in": "path", "required": true, "type": "string"}]}, "/auth/forget-password-email/": {"post": {"operationId": "auth_forget-password-email_create", "summary": "Request Password Reset", "description": "\nThis endpoint is responsible for initiating the password reset process by collecting the user's email address.\n\n### Workflow:\n1. **Email Validation:** The system verifies if the email belongs to a registered user.\n2. **Token Generation:** If the email is valid, a unique password reset token is generated.\n3. **Email Dispatch:** A password reset link containing the token is sent to the user's email.\n4. **Error Handling:** Errors related to email delivery (SMTP, connection, timeout) are handled gracefully.\n\n### Request Fields:\n- **email_address** (string): The registered email address of the user requesting a password reset.\n\n### Responses:\n- **200 OK**: Password reset email sent successfully.\n- **404 Not Found**: User with the provided email does not exist.\n- **500 Internal Server Error**: An error occurred while sending the reset email (SMTP issues, connection refused, or timeout).\n- **400 Bad Request**: Invalid input data.\n\n### Example Usage:\n```\nPOST /api/forgot-password/\n{\n    \"email_address\": \"user@example.com\"\n}\n```\n\n### Example Response (Success):\n```\nHTTP 200 OK\n{\n    \"message\": \"Reset email successfully sent. Please check your email.\",\n    \"uidb64\": \"encoded_user_id\",\n    \"token\": \"generated_token\"\n}\n```\n\n### Example Response (User Not Found):\n```\nHTTP 404 Not Found\n{\n    \"message\": \"User with this email does not exist.\"\n}\n```\n\n### Example Response (SMTP Error):\n```\nHTTP 500 Internal Server Error\n{\n    \"message\": \"There was an error sending the reset email. Please try again later.\",\n    \"error\": \"SMTPException details\"\n}\n```\n\n### Example Response (Connection Error):\n```\nHTTP 500 Internal Server Error\n{\n    \"message\": \"Could not connect to the email server. Please check your email settings.\",\n    \"error\": \"ConnectionRefusedError details\"\n}\n```\n\n### Example Response (Timeout):\n```\nHTTP 500 Internal Server Error\n{\n    \"message\": \"Email server timeout. Please try again later.\",\n    \"error\": \"TimeoutError details\"\n}\n```\n", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/ForgetPasswordEmailRequest"}}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/ForgetPasswordEmailRequest"}}}, "tags": ["auth"]}, "parameters": []}, "/auth/list/sub-account/": {"get": {"operationId": "auth_list_sub-account_list", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["auth"]}, "parameters": []}, "/auth/login/": {"post": {"operationId": "auth_login_create", "summary": "User Login", "description": "This endpoint allows users to log in using their email and password.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"required": ["email", "password"], "type": "object", "properties": {"email": {"description": "Registered email of the user", "type": "string", "format": "email"}, "password": {"description": "User's password", "type": "string", "format": "password"}}}}], "responses": {"200": {"description": "Login successful", "examples": {"application/json": {"message": "Login successfully", "tokens": {"access": "your_access_token_here", "refresh": "your_refresh_token_here"}}}}, "400": {"description": "Invalid credentials", "examples": {"application/json": {"message": "Invalid credentials"}}}}, "tags": ["auth"]}, "parameters": []}, "/auth/logs/": {"get": {"operationId": "auth_logs_list", "description": "", "parameters": [{"name": "page", "in": "query", "description": "A page number within the paginated result set.", "required": false, "type": "integer"}], "responses": {"200": {"description": "", "schema": {"required": ["count", "results"], "type": "object", "properties": {"count": {"type": "integer"}, "next": {"type": "string", "format": "uri", "x-nullable": true}, "previous": {"type": "string", "format": "uri", "x-nullable": true}, "results": {"type": "array", "items": {"$ref": "#/definitions/AuthLog"}}}}}}, "tags": ["auth"]}, "parameters": []}, "/auth/register/": {"post": {"operationId": "auth_register_create", "summary": "User Registration Endpoint", "description": "This endpoint allows users to register based on their role. Different fields are required for different roles.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"required": ["role"], "type": "object", "properties": {"role": {"description": "User role (individual account, agent account/freight forwarders, company account)", "type": "string", "enum": ["individual account", "agent account/freight forwarders", "company account"]}}}}], "responses": {"201": {"description": "", "schema": {"required": ["role"], "type": "object", "properties": {"role": {"description": "User role (individual account, agent account/freight forwarders, company account)", "type": "string", "enum": ["individual account", "agent account/freight forwarders", "company account"]}}}}}, "tags": ["auth"]}, "parameters": []}, "/auth/resend-otp/": {"put": {"operationId": "auth_resend-otp_update", "summary": "Resend OTP", "description": "This endpoint allows users to request a new OTP if their OTP expired.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/ResendOTP"}}], "responses": {"201": {"description": "OTP resent successfully", "examples": {"application/json": {"message": "OTP has been sent"}}}, "400": {"description": "Invalid request", "examples": {"application/json": {"error": "Invalid data"}}}, "404": {"description": "User not found", "examples": {"application/json": {"error": "User with this email not found"}}}}, "tags": ["auth"]}, "parameters": []}, "/auth/reset-password-token-check/{uidb64}/{token}/": {"get": {"operationId": "auth_reset-password-token-check_read", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["auth"]}, "parameters": [{"name": "uidb64", "in": "path", "required": true, "type": "string"}, {"name": "token", "in": "path", "required": true, "type": "string"}]}, "/auth/set-new-password/": {"patch": {"operationId": "auth_set-new-password_partial_update", "summary": "Reset User's Password", "description": "\nThis endpoint allows the user to reset their password after verifying their token and UID. The new password must meet the following security criteria:\n\n### Password Requirements:\n- **At least one uppercase letter** (A-Z)\n- **At least one digit** (0-9)\n- **At least one special character** from the set: `!@#$%^&*()-_=+{};:,<.>`\n\n### Workflow:\n1. **Token and UID Validation:** The system validates the provided user ID (UID) and password reset token.\n2. **Password Update:** If the token is valid and has not expired, the user's password is updated with the new password.\n3. **Token Invalidation:** The token is marked as used, and further requests with this token will be rejected.\n\n### Common Error Responses:\n- **400 Bad Request**: Invalid or missing token, invalid UID, or non-compliant password.\n- **400 Token Expired**: Token has expired and can no longer be used.\n- **400 Token Already Used**: Token has already been used to reset the password.\n- **200 OK**: Password reset was successful.\n\n### Example Usage:\n```\nPATCH /api/set-new-password/\n{\n    \"uidb64\": \"encoded_user_id\",\n    \"token\": \"reset_token\",\n    \"password\": \"NewPassword123!\"\n}\n```\n\n### Example Responses:\n- **Success (200 OK)**:\n```\n{\n    \"message\": \"Password updated successfully.\"\n}\n```\n\n- **Invalid Token (400 Bad Request)**:\n```\n{\n    \"error\": \"Invalid token.\"\n}\n```\n\n- **Token Expired (400 Bad Request)**:\n```\n{\n    \"error\": \"Token has expired.\"\n}\n```\n\n- **Token Already Used (400 Bad Request)**:\n```\n{\n    \"error\": \"Token has already been used.\"\n}\n```\n\n- **Invalid UID (400 Bad Request)**:\n```\n{\n    \"error\": \"Invalid UID or user not found.\"\n}\n```\n\n- **Password Validation Failure (400 Bad Request)**:\n```\n{\n    \"password\": [\"Password must contain at least one uppercase letter, one digit, and one special character.\"]\n}\n```\n", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/SetNewPassword"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/SetNewPassword"}}}, "tags": ["auth"]}, "parameters": []}, "/auth/verify-otp/": {"post": {"operationId": "auth_verify-otp_create", "summary": "Verify OTP", "description": "Verifies the OTP sent to the user's email or phone. The token is passed as a query parameter in the URL (e.g., /verify-otp/?token=...).", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"required": ["otp", "phone_number"], "type": "object", "properties": {"otp": {"description": "OTP code", "type": "string"}, "phone_number": {"description": "Phone number", "type": "string"}}}}], "responses": {"201": {"description": "", "schema": {"required": ["otp", "phone_number"], "type": "object", "properties": {"otp": {"description": "OTP code", "type": "string"}, "phone_number": {"description": "Phone number", "type": "string"}}}}}, "tags": ["auth"]}, "parameters": []}, "/products/list/": {"get": {"operationId": "products_list_list", "summary": "List all active products", "description": "Retrieve a list of all products that are currently active.", "parameters": [], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/ProductSerializers"}}}}, "tags": ["products"]}, "parameters": []}, "/products/plans/": {"get": {"operationId": "products_plans_list", "summary": "List all plans", "description": "Retrieve a list of all plans that are currently active.", "parameters": [], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/ProductSerializers"}}}}, "tags": ["products"]}, "parameters": []}, "/tracker/generate_tracking_id/{slug}/": {"patch": {"operationId": "tracker_generate_tracking_id_partial_update", "summary": "Generate a tracking ID for a consignment based on bill_of_ladding", "description": "Updates the Tracker fields based on the provided bill_of_ladding.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Tracker"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Tracker"}}}, "tags": ["tracker"]}, "parameters": [{"name": "slug", "in": "path", "required": true, "type": "string"}]}, "/tracker/get-consignment/": {"get": {"operationId": "tracker_get-consignment_list", "summary": "Get all consignments on daily basis", "description": "Get all consignments on daily basis", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["tracker"]}, "parameters": []}, "/tracker/get-teaser/": {"post": {"operationId": "tracker_get-teaser_create", "summary": "Get the consignment teaser for an importer using the bill of ladding", "description": "Get the consignment teaser for an importer using the bill of laddin", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/GetTeaserSerialiser"}}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/GetTeaserSerialiser"}}}, "tags": ["tracker"]}, "parameters": []}, "/tracker/status/{bill_of_ladding}/": {"get": {"operationId": "tracker_status_read", "summary": "Get the current stage/status of a consignment", "description": "Get the current stage/status of a consignment", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["tracker"]}, "parameters": [{"name": "bill_of_ladding", "in": "path", "required": true, "type": "string"}]}, "/verifications/cac/": {"post": {"operationId": "verifications_cac_create", "summary": "Submit CAC Verification Request", "description": "Allows a user to submit CAC verification documents (CAC certificate, status certificate, and letter of authorization).", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/CACVerificationSerializers"}}], "responses": {"200": {"description": "Verification request submitted successfully.", "examples": {"application/json": {"message": "Verification request successfully, please check your email"}}}, "400": {"description": "Validation errors or user not found.", "examples": {"application/json": {"error": "User does not exist"}}}}, "tags": ["verifications"]}, "parameters": []}, "/verifications/nin/": {"post": {"operationId": "verifications_nin_create", "summary": "Verify NIN endpoint", "description": "Allow users to verify their NIN", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/NINVerification"}}], "responses": {"201": {"description": "NIN verified successfully", "examples": {"application/json": {"message": "Product added successfully"}}}, "400": {"description": "Validation error", "examples": {"application/json": {"error": ["NIN not found for this record."]}}}}, "tags": ["verifications"]}, "parameters": []}, "/vin/certificate/{slug}/": {"get": {"operationId": "vin_certificate_read", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["vin"]}, "parameters": [{"name": "slug", "in": "path", "required": true, "type": "string"}]}, "/vin/data-upload/": {"post": {"operationId": "vin_data-upload_create", "summary": "Upload a file and process custom duty payment.", "description": "\nThis endpoint allows you to upload a file (CSV, Excel, JSON, or XML) \nand updates the custom duty payment based on the content of the file.\nSupported formats: CSV, Excel (.xls/.xlsx), JSON, XML. The file size limit is 5MB.\n", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"type": "object", "properties": {"file": {"description": "File to upload (CSV, Excel, JSON, or XML). Max size: 5MB", "type": "file"}}}}], "responses": {"200": {"description": "File processed and saved successfully.", "examples": {"application/json": {"message": "File processed and saved successfully.", "file_url": "http://example.com/uploads/yourfile.csv", "result": {"processed_data": "Details about processed data"}}}}, "400": {"description": "Bad request, file validation failed.", "examples": {"application/json": {"error": "Invalid file format. Please upload a CSV, Excel, JSON, or XML file."}}}}, "tags": ["vin"]}, "parameters": []}, "/vin/multi-upload-search/": {"post": {"operationId": "vin_multi-upload-search_create", "summary": "Upload an Excel file with VINs for validation", "description": "This endpoint allows users to upload an Excel file (.xlsx) containing a list of VINs. The VINs are validated against an external API and compared with the database records.", "parameters": [{"name": "file", "in": "formData", "description": "Excel file (.xlsx) containing a 'vin' column", "required": true, "type": "file"}], "responses": {"200": {"description": "VIN validation results", "examples": {"application/json": {"message": "Ok", "data": [{"vin": "1HGCM82633A123456", "owner": "John Doe", "registered": true}, {"vin": "JH4KA8260MC123456", "status": "Not found in database"}]}}}, "400": {"description": "Bad Request - File missing or invalid format"}, "404": {"description": "No valid VINs found"}, "500": {"description": "Server Error"}}, "consumes": ["multipart/form-data", "application/x-www-form-urlencoded"], "tags": ["vin"]}, "parameters": []}, "/vin/search-history/": {"get": {"operationId": "vin_search-history_list", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["vin"]}, "parameters": []}, "/vin/single-multi-search/": {"get": {"operationId": "vin_single-multi-search_list", "description": "", "parameters": [{"name": "vins", "in": "query", "description": "List of VINs (comma-separated)", "required": true, "type": "array", "items": {"type": "string"}}], "responses": {"200": {"description": ""}}, "tags": ["vin"]}, "parameters": []}}, "definitions": {"TokenObtainPair": {"required": ["email", "password"], "type": "object", "properties": {"email": {"title": "Email", "type": "string", "minLength": 1}, "password": {"title": "Password", "type": "string", "minLength": 1}}}, "TokenRefresh": {"required": ["refresh"], "type": "object", "properties": {"refresh": {"title": "Refresh", "type": "string", "minLength": 1}, "access": {"title": "Access", "type": "string", "readOnly": true, "minLength": 1}}}, "TokenVerify": {"required": ["token"], "type": "object", "properties": {"token": {"title": "Token", "type": "string", "minLength": 1}}}, "SubAccount": {"required": ["first_name", "last_name", "email", "phone_number", "location", "account_type", "department", "password", "confirm_password"], "type": "object", "properties": {"first_name": {"title": "First name", "type": "string", "maxLength": 255, "minLength": 1}, "last_name": {"title": "Last name", "type": "string", "maxLength": 255, "minLength": 1}, "email": {"title": "Email", "type": "string", "format": "email", "maxLength": 254, "minLength": 1}, "phone_number": {"title": "Phone number", "type": "string", "maxLength": 15, "minLength": 1}, "location": {"title": "Location", "type": "string", "maxLength": 255, "minLength": 1}, "account_type": {"title": "Account type", "type": "string", "enum": ["sub-account company", "sub-account agent"]}, "department": {"title": "Department", "type": "string"}, "password": {"title": "Password", "type": "string", "minLength": 1}, "confirm_password": {"title": "Confirm password", "type": "string", "minLength": 1}}}, "ForgetPasswordEmailRequest": {"required": ["email"], "type": "object", "properties": {"email": {"title": "Email", "type": "string", "format": "email", "minLength": 8}}}, "AuthLog": {"required": ["event_type"], "type": "object", "properties": {"id": {"title": "ID", "type": "integer", "readOnly": true}, "event_type": {"title": "Event type", "type": "string", "enum": ["LOGIN_SUCCESS", "LOGIN_FAILED", "LOGOUT", "PASSWORD_RESET_REQUEST", "PASSWORD_RESET_COMPLETED"]}, "timestamp": {"title": "Timestamp", "type": "string", "format": "date-time", "readOnly": true}, "ip_address": {"title": "Ip address", "type": "string", "minLength": 1, "x-nullable": true}, "user_agent": {"title": "User agent", "type": "string", "x-nullable": true}, "failure_reason": {"title": "Failure reason", "type": "string", "x-nullable": true}, "user": {"title": "User", "type": "integer", "x-nullable": true}}}, "ResendOTP": {"required": ["email", "phone_number", "message_choice"], "type": "object", "properties": {"email": {"title": "Email", "type": "string", "format": "email", "minLength": 1}, "phone_number": {"title": "Phone number", "type": "string", "minLength": 1}, "message_choice": {"title": "Message choice", "type": "string", "enum": ["email", "sms", "whatsapp"]}}}, "SetNewPassword": {"required": ["password", "confirm_password", "token", "uidb64"], "type": "object", "properties": {"password": {"title": "Password", "type": "string", "minLength": 8}, "confirm_password": {"title": "Confirm password", "type": "string", "minLength": 8}, "token": {"title": "Token", "type": "string", "minLength": 1}, "uidb64": {"title": "Uidb64", "type": "string", "minLength": 1}}}, "ProductSerializers": {"required": ["name", "description", "price"], "type": "object", "properties": {"name": {"title": "Name", "type": "string", "maxLength": 50, "minLength": 1}, "description": {"title": "Description", "type": "string", "maxLength": 150, "minLength": 1}, "price": {"title": "Price", "type": "string", "format": "decimal"}, "is_plan_based": {"title": "Is plan based", "type": "boolean"}, "is_active": {"title": "Is active", "type": "boolean"}, "action_type": {"title": "Action type", "type": "string", "enum": ["pay and download", "pay and not download"]}}}, "Tracker": {"type": "object", "properties": {"user_id": {"title": "User id", "type": "string", "maxLength": 50, "x-nullable": true}}}, "GetTeaserSerialiser": {"type": "object", "properties": {"bill_of_ladding": {"title": "Bill of ladding", "type": "string", "maxLength": 150, "x-nullable": true}}}, "CACVerificationSerializers": {"required": ["email"], "type": "object", "properties": {"email": {"title": "Email", "type": "string", "format": "email", "minLength": 1}, "cac_certificate": {"title": "Cac certificate", "type": "string", "readOnly": true, "format": "uri"}, "status_certificate": {"title": "Status certificate", "type": "string", "readOnly": true, "format": "uri"}, "letter_of_authorization": {"title": "Letter of authorization", "type": "string", "readOnly": true, "format": "uri"}}}, "NINVerification": {"required": ["nin"], "type": "object", "properties": {"nin": {"title": "Nin", "type": "string", "maxLength": 11, "minLength": 11}}}}}